  | [y1, y2, y3, y4, y5, y6, y7], [x0, x1, x2, x3, x4, x5, x6, x7] => wVec8S y1 y2 y3 y4 y5 y6 y7 x0 x1 x2 x3 x4 x5 x6 x7
  | _, _ => wVecF 128 Y x 8

