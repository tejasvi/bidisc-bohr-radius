    domOKF 128 [y1, y2, y3, y4, y5, y6, y7] [[w0_0], [w1_0, w1_1], [w2_0, w2_1, w2_2], [w3_0, w3_1, w3_2, w3_3], [w4_0, w4_1, w4_2, w4_3, w4_4], [w5_0, w5_1, w5_2, w5_3, w5_4, w5_5], [w6_0, w6_1, w6_2, w6_3, w6_4, w6_5, w6_6], [w7_0, w7_1, w7_2, w7_3, w7_4, w7_5, w7_6, w7_7]] 8 = domOK8S y1 y2 y3 y4 y5 y6 y7 w0_0 w1_0 w1_1 w2_0 w2_1 w2_2 w3_0 w3_1 w3_2 w3_3 w4_0 w4_1 w4_2 w4_3 w4_4 w5_0 w5_1 w5_2 w5_3 w5_4 w5_5 w6_0 w6_1 w6_2 w6_3 w6_4 w6_5 w6_6 w7_0 w7_1 w7_2 w7_3 w7_4 w7_5 w7_6 w7_7 := by
