/-- `domOKF 128 Y Wr 8`, straight-line on the packed shapes (`domOKF` itself otherwise) -/
noncomputable def domOK8L (Y : List GI) (Wr : List (List GI)) : Bool :=
  match Y, Wr with
  | [y1, y2, y3, y4, y5, y6, y7], [[w0_0], [w1_0, w1_1], [w2_0, w2_1, w2_2], [w3_0, w3_1, w3_2, w3_3], [w4_0, w4_1, w4_2, w4_3, w4_4], [w5_0, w5_1, w5_2, w5_3, w5_4, w5_5], [w6_0, w6_1, w6_2, w6_3, w6_4, w6_5, w6_6], [w7_0, w7_1, w7_2, w7_3, w7_4, w7_5, w7_6, w7_7]] => domOK8S y1 y2 y3 y4 y5 y6 y7 w0_0 w1_0 w1_1 w2_0 w2_1 w2_2 w3_0 w3_1 w3_2 w3_3 w4_0 w4_1 w4_2 w4_3 w4_4 w5_0 w5_1 w5_2 w5_3 w5_4 w5_5 w6_0 w6_1 w6_2 w6_3 w6_4 w6_5 w6_6 w7_0 w7_1 w7_2 w7_3 w7_4 w7_5 w7_6 w7_7
  | _, _ => domOKF 128 Y Wr 8

theorem domOK8L_eq (Y : List GI) (Wr : List (List GI)) : domOK8L Y Wr = domOKF 128 Y Wr 8 := by
  unfold domOK8L
  split
  · exact (domOK8S_eq ..).symm
  · rfl

/-- `domOKF`, with the straight-line version for `E = 128`, `n = 8` -/
noncomputable def domOKFast (E : Nat) (Y : List GI) (Wr : List (List GI)) (n : Nat) : Bool :=
  if E = 128 ∧ n = 8 then domOK8L Y Wr else domOKF E Y Wr n

theorem domOKFast_eq (E : Nat) (Y : List GI) (Wr : List (List GI)) (n : Nat) : domOKFast E Y Wr n = domOKF E Y Wr n := by
  unfold domOKFast
  split
  · next h => obtain ⟨rfl, rfl⟩ := h; exact domOK8L_eq Y Wr
  · rfl

